{
  "name": "@punctual/engine",
  "version": "0.3.0",
  "description": "Edge-native scheduling engine — the complete single-team product, on Cloudflare Workers",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/fakes.ts"
  },
  "files": [
    "src",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node -e \"const f=require('fs');f.existsSync('.dev.vars')||f.copyFileSync('.dev.vars.example','.dev.vars')\" && wrangler dev",
    "deploy": "wrangler deploy",
    "migrate": "wrangler d1 migrations apply punctual",
    "migrate:local": "wrangler d1 migrations apply punctual --local",
    "test": "vitest run",
    "test:core": "vitest run test/core",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cf-wasm/photon": "^0.4.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "satori": "^0.29.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261012.1",
    "@types/node": "^26.6.4",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=20"
  }
}
